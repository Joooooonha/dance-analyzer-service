# 이 파일을 복사해서 `application-secret.properties`로 만들고 실제 값을 채운다.
#
#   cp application-secret.properties.example application-secret.properties
#
# `application-secret.properties`는 .gitignore에 등록돼 있어 커밋되지 않는다.
# **이 example 파일에는 실제 값을 적지 말 것** — 이건 커밋된다.
#
# 운영(EC2)에서는 이 파일 대신 환경변수로 주입하는 편이 낫다.
# 파일은 서버에 그대로 남지만 환경변수는 프로세스에만 있다.

# ===== 소셜 로그인 =====
# 카카오: 앱 키 → REST API 키 / 보안 → Client Secret
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# 네이버: 애플리케이션 등록 후 Client ID / Client Secret
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ===== 저장소 (Cloudflare R2) =====
# storage.type=r2 일 때만 필요. local(개발 기본값)이면 비워둬도 된다.
R2_BUCKET=odostudio-media
R2_ENDPOINT=
R2_ACCESS_KEY=
R2_SECRET_KEY=

# ===== 인증 =====
# HS256이라 32바이트(영문 32자) 이상이어야 한다.
# 만들기: openssl rand -base64 48
JWT_SECRET=

# ===== 분석 서버 (맥미니, Tailscale 내부 주소) =====
AI_SERVER_URL=http://100.x.x.x:8000
